const ROSTER_BY_RARITY: Readonly<Record<RoninRarity, readonly RoninFighter[]>> = {
  common: RONIN_ROSTER.filter((f) => f.rarity === 'common'),
  uncommon: RONIN_ROSTER.filter((f) => f.rarity === 'uncommon'),
  rare: RONIN_ROSTER.filter((f) => f.rarity === 'rare'),
  epic: RONIN_ROSTER.filter((f) => f.rarity === 'epic'),
  legendary: RONIN_ROSTER.filter((f) => f.rarity === 'legendary'),
  mythical: RONIN_ROSTER.filter((f) => f.rarity === 'mythical'),
}

export function rosterByRarity(rarity: RoninRarity): readonly RoninFighter[] {
  return ROSTER_BY_RARITY[rarity]
}

// ─── Roll → rarity → fighter (receipt re-derives through these) ─────────────

/**
 * Map a uniform roll ∈ [0, WEIGHT_TOTAL) onto the price point's rarity table
 * by cumulative walk, RAREST-FIRST (the small slices sit at the front of the
 * line, mirroring the gold-slice-last convention read the other way).
 *
 * @throws on out-of-range roll. Fail-closed.
 */
export function rollToRarity(roll: bigint, priceId: string): RoninRarity {
  const price = RONIN_PRICES.find((p) => p.id === priceId)
  if (!price) throw new Error(`ronin: unknown price point ${priceId}`)
  if (roll < 0n || roll >= WEIGHT_TOTAL) {
    throw new Error(`ronin: roll ${roll} out of band [0, ${WEIGHT_TOTAL})`)
  }
  let cum = 0n
  for (let i = RARITY_ORDER.length - 1; i >= 0; i--) {
    const rarity = RARITY_ORDER[i]!
    cum += price.odds[rarity]
    if (roll < cum) return rarity
  }
  throw new Error('ronin: rarity table walk fell through')
}

/** Map a uniform character roll onto the rarity's pool (index mod pool). The
 *  provider derives charRoll uniformly over the POOL SIZE (rejection-sampled),
 *  so this is a direct index. */
export function charAt(rarity: RoninRarity, index: number): RoninFighter {
  const pool = ROSTER_BY_RARITY[rarity]
  const f = pool[index]
  if (!f) throw new Error(`ronin: char index ${index} out of pool ${rarity} (${pool.length})`)
  return f
}

// ─── Load-time mirror check (drift gate, mirrors vendingMath) ───────────────

function roninMirrorCheck(): void {
  // (a) every price point's odds sum EXACTLY to WEIGHT_TOTAL.
  for (const p of RONIN_PRICES) {
    let sum = 0n
    for (const r of RARITY_ORDER) sum += p.odds[r]
    if (sum !== WEIGHT_TOTAL) {
      throw new Error(`ronin odds drift (${p.id}): Σ weights ${sum} ≠ ${WEIGHT_TOTAL}`)
    }
  }
  // (b) prices strictly ascend and top-tier odds strictly improve with price
  //     (the "higher price = better odds" promise, asserted).
  for (let i = 1; i < RONIN_PRICES.length; i++) {
    const lo = RONIN_PRICES[i - 1]!
    const hi = RONIN_PRICES[i]!
    if (hi.lamports <= lo.lamports) throw new Error('ronin drift: price ladder not ascending')
    if (hi.odds.mythical <= lo.odds.mythical || hi.odds.legendary <= lo.odds.legendary) {
      throw new Error('ronin drift: top-tier odds do not improve with price')
    }
  }
  // (c) roster ids unique; every rarity pool non-empty.
  const seen = new Set<string>()
  for (const f of RONIN_ROSTER) {
    if (seen.has(f.id)) throw new Error(`ronin drift: duplicate roster id ${f.id}`)
    seen.add(f.id)
  }
  for (const r of RARITY_ORDER) {
    if (ROSTER_BY_RARITY[r].length === 0) throw new Error(`ronin drift: empty pool ${r}`)
  }
  // (d) boundary spot-checks on the cheapest and richest points.
  if (rollToRarity(0n, 'p50') !== 'mythical') throw new Error('ronin drift: p50 roll 0 ≠ mythical')
  if (rollToRarity(WEIGHT_TOTAL - 1n, 'p5') !== 'common') {
    throw new Error('ronin drift: p5 last roll ≠ common')
  }
  if (rollToRarity(99n, 'p5') !== 'mythical' || rollToRarity(100n, 'p5') !== 'legendary') {
    throw new Error('ronin drift: p5 mythical slice boundary moved')
  }
}

roninMirrorCheck()
