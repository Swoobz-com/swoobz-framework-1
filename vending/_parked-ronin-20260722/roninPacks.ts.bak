/**
 * AUTOMAT — RONIN ZERO fighter-pack machine (machine #4 on the turntable).
 *
 * COSMETIC MACHINE, by Tim's explicit decision (2026-07-20): packs cost demo
 * balance ($5/$10/$25/$50 per pack) and pay FIGHTER CARDS, never money. There
 * is NO payout path in this file — no RTP surface — so unlike vendingMath the
 * knob that scales with price is the RARITY ODDS (higher price = better odds
 * for the top tiers). The odds below are the REAL draw weights and are
 * rendered verbatim in the UI (the disclosure IS the data).
 *
 * Fairness structure mirrors vendingMath/vendingProvider anyway: integer
 * weights over WEIGHT_TOTAL = 100 000, seed-committed derivation in
 * roninProvider (domain tags RONINPACK/RONINCHAR), and a load-time
 * mirror check that throws on any drift.
 *
 * Roster: Tim's "NOT FINAL MKOMBAT" set (56 fighters, /skin/roster/<id>.webp)
 * + RONIN ZERO himself (crest card until his art lands). Tier split per Tim's
 * rule: normal humans low (common/uncommon), monsters high, MYTHICAL = the
 * red takeover class.
 */
import { WEIGHT_TOTAL } from './vendingMath'
import type { VendingTierId } from './vendingMath'

/** The four machines on the turntable: the three money tiers + RONIN ZERO. */
export type MachineId = VendingTierId | 'ronin'
export const RONIN_MACHINE_ID = 'ronin' as const

// ─── Rarity ladder ──────────────────────────────────────────────────────────

export type RoninRarity = 'common' | 'uncommon' | 'rare' | 'epic' | 'legendary' | 'mythical'
export const RARITY_ORDER: readonly RoninRarity[] = [
  'common',
  'uncommon',
  'rare',
  'epic',
  'legendary',
  'mythical',
]
export const RARITY_RANK: Readonly<Record<RoninRarity, number>> = {
  common: 0,
  uncommon: 1,
  rare: 2,
  epic: 3,
  legendary: 4,
  mythical: 5,
}
/** Rarity color language (content colors, rarity-keyed — mythical is THE red
 *  Ronin Zero takeover; identical presentation for every mythical card). */
export const RARITY_STYLE: Readonly<
  Record<RoninRarity, { label: string; color: string; ray: string; rayAlpha: number }>
> = {
  common: { label: 'COMMON', color: '#9aa3ad', ray: '154,163,173', rayAlpha: 0 },
  uncommon: { label: 'UNCOMMON', color: '#4ade80', ray: '74,222,128', rayAlpha: 0.2 },
  rare: { label: 'RARE', color: '#38bdf8', ray: '56,189,248', rayAlpha: 0.32 },
  epic: { label: 'EPIC', color: '#a78bfa', ray: '167,139,250', rayAlpha: 0.46 },
  legendary: { label: 'LEGENDARY', color: '#f0a13c', ray: '240,161,60', rayAlpha: 0.6 },
  mythical: { label: 'MYTHICAL', color: '#e5484d', ray: '229,72,77', rayAlpha: 0.78 },
}

// ─── Price points (fixed ladder — the odds knob) ────────────────────────────

export interface RoninPricePoint {
  /** Stable id — the fairness domain tag keys off this, never the label. */
  readonly id: string
  readonly lamports: bigint
  readonly label: string
  readonly headline: string
  /** REAL draw weights per rarity, Σ === WEIGHT_TOTAL (100 000). */
  readonly odds: Readonly<Record<RoninRarity, bigint>>
}

