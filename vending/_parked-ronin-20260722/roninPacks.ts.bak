/** Format a rarity weight as a percent string ("13%", "0.1%"). Display only. */
export function oddsPercent(weight: bigint): string {
  const whole = weight / 1_000n
  const tenth = (weight % 1_000n) / 100n
  return tenth === 0n ? `${whole}%` : `${whole}.${tenth}%`
}

// ─── The roster ─────────────────────────────────────────────────────────────

export interface RoninFighter {
  /** Stable id; art lives at /skin/roster/<id>.webp (null art = crest card). */
  readonly id: string
  readonly name: string
  readonly rarity: RoninRarity
  readonly art: string | null
}

function F(id: string, name: string, rarity: RoninRarity): RoninFighter {
  return { id, name, rarity, art: `/skin/roster/${id}.webp` }
}

